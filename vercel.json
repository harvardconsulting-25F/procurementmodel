{
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "az_ui_demo_MHEdit/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api(?:/.*)?",
      "dest": "az_model/api.py"
    },
    {
      "src": "/(.*)",
      "dest": "az_ui_demo_MHEdit/dist/$1"
    }
  ]
}
